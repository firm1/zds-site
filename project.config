[project]
	description = D�pot ZDS
[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/firm1
[access "refs/for/refs/*"]
	read = group user/firm1
	push = group user/firm1
	label-Code-Review = -2..+2 group user/firm1
	label-Verified = -1..+1 group user/firm1
	rebase = group user/firm1
	removeReviewer = group user/firm1
	submit = group user/firm1
[access "refs/heads/*"]
	read = group user/firm1
	create = group user/firm1
	push = +force group user/firm1
	pushMerge = group user/firm1
[access "refs/tags/*"]
	push = +force group user/firm1
	pushTag = group user/firm1
	pushSignedTag = group user/firm1
